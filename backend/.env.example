# Template for backend/.env — copy to `.env` on the target machine and adjust.
# `.env` itself is gitignored; `docker compose` auto-loads it from this directory.

# ── Images / ports ────────────────────────────────────────────────────────
VBCD_BACKEND_IMAGE=vbcd-backend:latest
VBCD_FRONTEND_IMAGE=vbcd-frontend:latest
SERVER_PORT=8081
FRONTEND_PORT=80

# ── CORS ──────────────────────────────────────────────────────────────────
# Origins the browser is allowed to call the API from. Scheme+host+port must
# match exactly what users type in the address bar.
CORS_ALLOWED_ORIGIN_PATTERNS=https://voxel-based-change-detection.gaia3d.dev,http://192.168.10.75,http://192.168.10.75:*

# ── Database ──────────────────────────────────────────────────────────────
DB_HOST=postgis
DB_PORT=5432
DB_HOST_PORT=5432
DB_NAME=voxel_change_detection
DB_USER=voxel
DB_PASSWORD=voxel

# ── Host paths (server machine) ───────────────────────────────────────────
VBCD_DATA_DIR=/opt/vbcd/data
VBCD_DB_DIR=/opt/vbcd/postgis-data
VOXELIZER_HOST_JAR=/opt/vbcd/mago-voxelizer.jar

# ── Voxelizer ─────────────────────────────────────────────────────────────
VOXELIZER_MOCK_EXECUTION=false
VOXELIZER_STORAGE_ROOT=/data
VOXELIZER_TEMP_PATH=/data/temp
VOXELIZER_VISUALIZATION_TILES_PATH=/data/3dtiles
VOXELIZER_VOXEL_SET_OUTPUT_PATH=/data/voxelsets
VOXELIZER_JAR_PATH=/app/mago-voxelizer.jar
VOXELIZER_DEFAULT_CREATE_MAX_LEVEL=15
VOXELIZER_DEFAULT_CREATE_REGION_GPKG_PATH=/data/Asan-LandCoverIndex-Vegetation.gpkg
VOXELIZER_DEFAULT_DIFF_MAX_LEVEL=15
VOXELIZER_DEFAULT_DIFF_DIFF_NEIGHBOR_MODE=6
VOXELIZER_DEFAULT_DIFF_MIN_DIFF_FILTER_LEVEL=12
VOXELIZER_DEFAULT_DIFF_MIN_DIFF_NEIGHBORS=3
VOXELIZER_DEFAULT_DIFF_DIFF_NEIGHBOR_ITERATIONS=2
VOXELIZER_DEFAULT_DIFF_MIN_DIFF_CLUSTER_SIZE=20
