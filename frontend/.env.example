# Template for frontend/.env — copy to `.env` and adjust.
# `.env` itself is gitignored; this example file is the committed reference.

# Max upload size in MB for observation tileset zips.
# Must not exceed the smallest body-size limit in the chain:
# external HTTPS proxy (100MB) / frontend nginx client_max_body_size / Spring multipart.
VITE_MAX_UPLOAD_MB=100

# Backend API base URL.
# - Leave UNSET (commented) for local dev → falls back to http://localhost:8080
# - Leave empty/unset in Docker builds → app uses the page's own origin via nginx proxy
#VITE_EXTERNAL_API_URL=http://localhost:8080

VBCD_BACKEND_IMAGE=vbcd-backend:latest
VBCD_DATA_DIR=/path/to/data
VBCD_DB_DIR=/path/to/postgis-data
VOXELIZER_HOST_JAR=/path/to/mago-voxelizer.jar
VOXELIZER_MOCK_EXECUTION=false
DB_PASSWORD=changeme
DB_HOST_PORT=5432
SERVER_PORT=8081

VBCD_FRONTEND_IMAGE=vbcd-frontend:latest
FRONTEND_PORT=8090